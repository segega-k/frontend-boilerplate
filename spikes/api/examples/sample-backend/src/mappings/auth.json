{
  "$schema": "../../../../packages/api/src/errors/mapping.schema.json",
  "service": "auth",
  "spec": "../../specs/auth.json",
  "operations": {
    "login": {
      "path": "/api/v1/auth/login",
      "method": "post",
      "responses": [
        {
          "variants": [
            "200"
          ],
          "type": "silent",
          "severity": "success"
        },
        {
          "variants": [
            "ERR"
          ],
          "type": "toast",
          "severity": "error",
          "support": true,
          "i18n": {
            "title": "somethingWentWrong",
            "subtitle": "pleaseTryAgainLater"
          }
        },
        {
          "variants": [
            "NET"
          ],
          "type": "toast",
          "severity": "error",
          "i18n": {
            "title": "noInternetConnection"
          }
        },
        {
          "variants": [
            "400_/api/problems/invalid_credentials"
          ],
          "type": "custom",
          "severity": "error",
          "i18n": {
            "title": "invalidLoginOrPassword"
          }
        },
        {
          "variants": [
            "403_/api/problems/user_blocked"
          ],
          "type": "silent",
          "severity": "error"
        }
      ]
    },
    "refresh": {
      "path": "/api/v1/auth/refresh",
      "method": "post",
      "responses": [
        {
          "variants": [
            "200"
          ],
          "type": "silent",
          "severity": "success"
        },
        {
          "variants": [
            "ERR"
          ],
          "type": "silent",
          "severity": "error"
        },
        {
          "variants": [
            "NET"
          ],
          "type": "silent",
          "severity": "error"
        },
        {
          "variants": [
            "401_/api/problems/refresh_token_expired"
          ],
          "type": "silent",
          "severity": "error"
        }
      ]
    }
  }
}
