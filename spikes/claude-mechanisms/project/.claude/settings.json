{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "Probe",
  "attribution": { "commit": "", "pr": "" },
  "autoMemoryEnabled": true,
  "enableAllProjectMcpServers": false,
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": ["Bash(git status *)", "Bash(git log *)", "PowerShell(git status *)", "PowerShell(git log *)"],
    "ask": ["Bash(git commit *)", "PowerShell(git commit *)"],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(secrets/**)",
      "Bash(git push --force *)",
      "PowerShell(git push --force *)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session-check.mjs"],
            "timeout": 20
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/log.mjs"] }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs"],
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/post.mjs"], "timeout": 60 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/stop.mjs"], "timeout": 60 }
        ]
      }
    ]
  }
}
